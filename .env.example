DATABASE_URL=postgresql://personas:password@localhost:5432/personas
DIRECT_DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3100
APP_URL=http://localhost:3100
FILE_STORAGE=local
LOCAL_STORAGE_DIR=.data/files
# Production: s3 with private bucket, encryption and lifecycle policies
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Transactional email through Resend (no email is sent without configuration)
RESEND_API_KEY=
EMAIL_FROM=
# Development capture writes private messages under .data/mail. Never enable in production.
LOCAL_EMAIL_CAPTURE=false
# Vercel AI Gateway. Pick a current structured-output-capable model explicitly.
AI_GATEWAY_API_KEY=
AI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=
CRON_SECRET=
UPLOAD_SCAN_URL=
UPLOAD_SCAN_TOKEN=
