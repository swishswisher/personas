{
  "name": "personas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:local": "node --import tsx scripts/local-db.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "worker": "node --import tsx scripts/worker.ts",
    "check": "npm run typecheck && npm test && npm run lint && npm run build",
    "dev:local": "node --import tsx scripts/dev.ts",
    "test:e2e": "npm run build && node --import tsx scripts/http-e2e.ts",
    "release:check-actions": "node scripts/check-actions.mjs",
    "healthcheck": "node --import tsx scripts/healthcheck.ts",
    "format:check": "prettier --check src scripts tests docs README.md",
    "db:migrate:sql": "node --import tsx scripts/migrate-sql.ts",
    "setup:env": "node scripts/prepare-env.mjs",
    "test:scanner": "node scripts/scanner-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "latest",
    "better-auth": "1.7.15",
    "lucide-react": "latest",
    "next": "16.4.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@prisma/client-generator-ts": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "latest",
    "typescript": "^5",
    "vitest": "latest"
  }
}
